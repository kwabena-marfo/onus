generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model users {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  display_name String
  last_loggin  String
  password     String
  role         String
  username     String
}

model verses {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  book         String    
  chapter      String
  verse        String
  version      String   
  onusVerse    String    
  verseNotes   String?   
  memorised    MemorisedStatus
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum MemorisedStatus {
  memorised
  saved
}