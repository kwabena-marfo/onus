generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model user {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  googleId    String?  @unique // Store Google ID here
  name        String
  email       String
  username    String?
  password    String?
  image       String?
  lastLogin   String? // fixed typo: "last_loggin" → "lastLogin"
  verses      verses[] // correct relation (no @relation needed here)
  scores      quizScore[]
}

model verses {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  book         String    
  chapter      String
  verse        String
  version      String?   
  onusVerse    String    
  verseNotes   String?   
  tags         Json?
  memorised    MemorisedStatus
  userId       String   @db.ObjectId
  user         user     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum MemorisedStatus {
  memorised
  saved
}

model quizScore {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  quizName   String   // e.g. "Matthew", "Mark", or "Quiz on Matthew"
  score      Int
  total      Int      // Total number of questions
  takenAt    DateTime @default(now())
  user       user   @relation(fields: [userId], references: [id])

  @@unique([userId, quizName])
}
